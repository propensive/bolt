tel 1.0 propensive.dev/bolt

# Bolt codes of Pyrocosm and its tools, which share the letter `f`: `subdivision 8` / `error 1` /
# `variant 3` is ↯/f.8.1.3. Each module of Pyrocosm is a subdivision, numbered so that each comes
# after those it depends on (`harness` 1 to `cli` 14); then the modules of each tool, in the order
# of their dependencies: fever 15–16, flame 17–20, flare 21–24, fuel 25–28, fume 29–32 and fury
# 33–34. Errors and the diagnostics a tool reports alike have codes. A code which carries another,
# as ↯/f.10.1/f.8.1.3 or ↯/f.21.1/c.2.2.1, reports its error on account of that one.

project f pyrocosm
  description  Pyrocosm, the framework of Propensive's tools, and the tools built on it

  subdivision 1 harness
  subdivision 2 model
  subdivision 3 compiler
  subdivision 4 media
  subdivision 5 script
  subdivision 6 system
  subdivision 7 notes
    error 1 Notes.Error
      description  An operation on the git notes in which Pyrocosm's tools record what they know fails
      source src/notes/pyrocosm.Notes.scala
      variant 1 BadRef
        description  a refspec does not name a commit
      variant 2 GitFailed
        description  git exits with a failing status
      variant 3 Undecodable
        description  a note cannot be decoded
      variant 4 Diverged
        description  the notes on a remote have diverged from the local notes
  subdivision 8 remote
    error 1 Peer.Error
      description  A connection to another machine cannot be made
      source src/remote/pyrocosm.Peer.scala
      variant 1 NoIdentity
        description  the machine declares no identity fingerprint to pin
      variant 2 NoToken
        description  the machine declares no token
      variant 3 Unreachable
        description  the machine cannot be connected to
      variant 4 Refused
        description  the peer refuses the connection
      variant 5 Protocol
        description  the peer speaks another protocol
      variant 6 Disconnected
        description  the peer closes the connection during the handshake
      variant 7 Identity
        description  this machine's identity cannot be created or read
    error 2 Invitation.Error
      description  An invitation to connect to a machine is not accepted
      source src/remote/pyrocosm.Invitation.scala
      variant 1 Malformed
        description  it is not an invitation
      variant 2 Expired
        description  it has expired
      variant 3 Used
        description  it has been used already
      variant 4 Tool
        description  it is an invitation to another tool
      variant 5 Unwritable
        description  the machine it invites to cannot be recorded
  subdivision 9 bus
  subdivision 10 swarm
    error 1 Swarm.Error
      description  A ping to another machine fails; a failed connection carries its own code, ↯/f.10.1/f.8.1.3, in place of a variant
      source src/swarm/pyrocosm.Swarm.scala
      variant 2 Unanswered
        description  the connection closes before a pong arrives
      variant 3 Silent
        description  no pong arrives in time
      variant 4 Mismatched
        description  the two nodes cannot agree a protocol
  subdivision 11 terminal
  subdivision 12 web
  subdivision 13 hub
  subdivision 14 cli

  # fever
  subdivision 15 core
    error 1 Launch.Error
      description  A compiled script has no entry point which Fever can run
      source src/core/fever.Launch.scala
      variant 1 NoMain
        description  the script defines no top-level `def main(using Runtime): Unit`
      variant 2 WrongSignature
        description  the script's `main` has a signature other than `def main(using Runtime): Unit`
      variant 3 Uninspectable
        description  the compiled script's TASTy cannot be inspected, or its class cannot be loaded
    error 2 Script.Error
      description  A script's header is invalid; a header which is not TEL carries TEL's own code, ↯/f.15.2/s.118.1/t.1.7, in place of a variant
      source src/core/fever.Script.scala
      variant 2 NoSeparator
        description  the file has no `##` line separating the header from the source
      variant 3 Invalid
        description  the header breaks the script schema; each rejection is a diagnostic carrying the code of the TEL error which found it
    error 3 NotResident
      description  A script named by `fever stop` is not resident in the daemon
      source src/core/fever.Scripts.scala
    error 4 CompilerCrash
      description  The compiler crashes rather than finishing a script's compilation
      source src/core/fever.Scripts.scala
    error 5 Unanticipated
      description  Running a script throws what no exit status anticipates, a bug in Fever; it carries the throwable's own code, if it has one
      source src/core/fever_cli.scala
    error 6 Unimplemented
      description  A subcommand is not yet implemented
      source src/core/fever_cli.scala
    error 7 Usage
      description  The command line is not understood
      source src/core/fever_cli.scala
  subdivision 16 launcher

  # flame
  subdivision 17 core
    error 1 SubmissionFailed
      description  A submission could not be evaluated, and is answered with a failure; a failure on account of a coded error carries that error's code
      source src/core/flame.Repl.scala
      variant 1 Unprocessed
        description  the input could not be compiled or run, because something escaped the engine's guards
      variant 2 Unrendered
        description  the result could not be rendered as a reply
      variant 3 Unanswered
        description  an asynchronous submission could not be processed
      variant 4 Thrown
        description  an asynchronous submission raised an error which no guard caught
    error 2 SessionRefused
      description  The session named at startup could not be opened as asked
      source src/core/flame.ReplInterface.scala
      variant 1 Missing
        description  no session of that name exists to join
      variant 2 Exists
        description  a session of that name already exists, so it cannot be created
    error 3 NoActiveSession
      description  A submission arrived on a connection which has no active session
      source src/core/flame.Sessions.scala
    error 4 RequestFailed
      description  A request to the REPL server could not be answered; a failure on account of a coded error carries that error's code
      source src/core/flame.Sessions.scala
      variant 1 Unparsed
        description  the request could not be parsed
      variant 2 Thrown
        description  answering the request raised an error
  subdivision 18 web
    error 1 RequestFailed
      description  A web page's request to the in-process sessions raised an error; it carries the error's own code, if it has one
      source src/web/flame_web.scala
    error 2 NoSuchSession
      description  A REST API request names a session which does not exist
      source src/web/flame_web.scala
    error 3 MalformedBody
      description  A REST API request's body is not the JSON the endpoint expects
      source src/web/flame_web.scala
      variant 1 Eval
        description  the body of an `eval` request is not `{"code": "…"}`
      variant 2 Complete
        description  the body of a `complete` request is not `{"code": "…", "offset": N}`
  subdivision 19 client
    error 1 SessionArguments
      description  The arguments choosing a session contradict each other, or are incomplete
      source src/client/flame_client.scala
      variant 1 JoinAndCreate
        description  both `--join` and `--create` are given
      variant 2 JoinUnnamed
        description  `--join` is given without a session name
      variant 3 CreateUnnamed
        description  `--create` is given without a session name
      variant 4 ConfigJoinAndCreate
        description  the workspace's `config.tel` names both a session to join and one to create
    error 2 Unserved
      description  A REPL server could not serve; a failure on account of a coded error carries that error's code
      source src/client/flame_client.scala
      variant 1 PortUnavailable
        description  the TCP port cannot be bound
      variant 2 Failed
        description  serving on the TCP port raised an error
      variant 3 SocketInUse
        description  the UNIX domain socket is already in use
      variant 4 SocketFailed
        description  serving on the UNIX domain socket raised an error
    error 3 InvalidArgument
      description  A command-line argument is invalid
      source src/client/flame_client.scala
      variant 1 Port
        description  the port is not a valid TCP port
      variant 2 HostMissing
        description  `--host` is given without a hostname
      variant 3 Host
        description  the hostname is not valid
    error 4 Unreachable
      description  The client could not reach a REPL server
      source src/client/flame_client.scala
      variant 1 Remote
        description  the server on the remote host and port refuses the connection
      variant 2 Socket
        description  the server on the UNIX domain socket refuses the connection
      variant 3 Launch
        description  a REPL server could not be started in the background
    error 5 SeveralServers
      description  Several local REPL servers are running, and the client cannot choose between them
      source src/client/flame_client.scala
    error 6 Terminal
      description  The terminal could not be initialised; the failure carries the terminal error's code
      source src/client/flame_client.scala
  subdivision 20 launcher

  # flare
  subdivision 21 plugin
    error 1 StyleViolation
      description  A source violates a rule of Consequent Style; the code carries the rule's own `c` code, as `↯/f.21.1/c.2.2.1`
      source src/plugin/flare.FlareBolts.scala
    error 2 ProjectViolation
      description  A source violates one of the project's own rules, which is named after the code
      source src/plugin/flare.Rule.scala
    error 3 Option
      description  An option given to the compiler plugin cannot be used
      source src/plugin/flare.Config.scala
      variant 1 NotCount
        description  a numeric option is not a non-negative integer
      variant 2 Header
        description  the licence header file cannot be read
      variant 3 Predicate
        description  a project rule names a predicate which does not exist
      variant 4 Rule
        description  a `rule` option is not `<name>:<predicate>:<target>`
      variant 5 Enforce
        description  an `enforce` option is not `<rule>` or `<rule>:<severity>`
      variant 6 Unknown
        description  the option is not one the plugin recognises
      variant 7 Undefined
        description  a rule is enforced but not defined
      variant 8 Empty
        description  a project rule has no predicates
      variant 9 Letter
        description  an `omit` or `strict` entry names a rule by the letter identifier it had before its code
  subdivision 22 records
  subdivision 23 client
    error 1 Configuration
      description  The configuration file cannot be used
      source src/client/flare.Workspace.scala
      variant 1 Missing
        description  no `.pyrocosm/flare/config.tel` is found at or above the directory
      variant 2 Unreadable
        description  the file cannot be read as TEL
      variant 3 NoProfile
        description  the file defines no profile
    error 2 Model
      description  A model target in the configuration is not well defined
      source src/client/flare.Workspace.scala
      variant 1 Unnamed
        description  the model has no name
      variant 2 Provider
        description  the provider is not one flare can consult
      variant 3 NoModel
        description  the target names no model
      variant 4 Mode
        description  the mode is neither `batches` nor `realtime`
      variant 5 Duplicate
        description  the model is defined more than once
    error 3 Assessment
      description  An assessment rule in the configuration is not well defined
      source src/client/flare.Workspace.scala
      variant 1 Keyword
        description  the rule uses a keyword which is not an assessment keyword
      variant 2 Unit
        description  the rule assesses something other than definitions
      variant 3 NoModel
        description  the rule names no model
      variant 4 UndefinedModel
        description  the rule names a model which is not defined
      variant 5 NoRubric
        description  the rule names no rubric
      variant 6 Weightless
        description  a criterion has no weight
      variant 7 Criterion
        description  a criterion has no id or no weight
      variant 8 DuplicateCriterion
        description  a criterion is defined more than once
      variant 9 NoCriteria
        description  the rule has no criteria
      variant 10 Bands
        description  the bands do not descend
      variant 11 Signal
        description  a signal has no kind or no points
    error 4 Rule
      description  A project rule in the configuration is not well defined
      source src/client/flare.Workspace.scala
      variant 1 Predicate
        description  the rule uses a keyword which is not a predicate
      variant 2 Target
        description  a predicate's target is not one it can match
      variant 3 Empty
        description  the rule has no predicates
      variant 4 Duplicate
        description  the rule is defined more than once
    error 5 Profile
      description  A profile in the configuration is not well defined
      source src/client/flare.Workspace.scala
      variant 1 Unnamed
        description  the profile has no name
      variant 2 Reserved
        description  the profile is named as a subcommand is
      variant 3 NoSources
        description  the profile names no sources
      variant 4 Style
        description  the style is not `consequent`
      variant 5 Enforced
        description  the profile enforces a rule which is not defined
      variant 6 Assessed
        description  the profile assesses a rule which is not an assessment rule
      variant 7 Duplicate
        description  the profile is defined more than once
    error 6 PluginOptions
      description  A profile cannot be used because the plugin rejects the options it amounts to; the code carries the plugin's `↯/f.21.3` variant
      source src/client/flare.Workspace.scala
    error 7 Selection
      description  The command line does not say what to check or assess
      source src/client/flare_client.scala
      variant 1 Profile
        description  the configuration defines several profiles and none is named
      variant 2 Assessments
        description  the profile assesses nothing and no assessment rule is named
    error 8 Parse
      description  A source file does not parse
      source src/client/flare.Frontend.scala
    error 9 NoRepository
      description  The project is not in a git repository, so nothing can be recorded
      source src/client/flare_client.scala
    error 10 Notes
      description  The git notes cannot be read or written
      source src/client/flare_client.scala
      variant 1 NoCensus
        description  no census is recorded for the commit or tree
      variant 2 Target
        description  the target is not a commit or a tree
      variant 3 Unwritten
        description  the notes cannot be written
      variant 4 InputTree
        description  the input tree cannot be written
      variant 5 NoAssessment
        description  no assessment is recorded for the commit or tree
    error 11 Assessing
      description  An assessment rule cannot be run
      source src/client/flare_client.scala
      variant 1 Model
        description  the rule names a model which is not defined
      variant 2 Rubric
        description  the rubric cannot be read
      variant 3 Credential
        description  no credential for the model can be found
    error 12 Batch
      description  A batch of candidates is not judged, because the model fails; the code carries the model's error
      source src/client/flare.Assessing.scala
  subdivision 24 launcher

  # fuel
  subdivision 25 core
    error 1 Unreadable
      description  A file cannot be read
      source src/core/fuel.Compilation.scala
    error 2 Unclosed
      description  A fence in a document is not closed
      source src/core/fuel.Doc.scala
    error 3 Ambiguous
      description  A reference in a document or on an API's page names more than one entity, so it is not linked
      source src/core/fuel.Doc.scala
    error 4 Glossary
      description  A glossary is not as it should be
      source src/core/fuel.Glossary.scala
      variant 1 Schema
        description  the glossary schema finds a fault; carries the code of the TEL error
      variant 2 Term
        description  a glossary which is not a translation gives a name a `term`
      variant 3 Unnameable
        description  a term's name holds a bracket, so it cannot be a term
      variant 4 Duplicate
        description  a term, or a name it has, is defined already
      variant 5 Short
        description  a term's name is one character, which any `[x]` in prose matches
      variant 6 UnnameableSynonym
        description  a synonym holds a bracket, so it cannot be a name
      variant 7 DuplicateSynonym
        description  a synonym is a name already
    error 5 Mirror
      description  A translation of a document differs in structure from the text it translates
      source src/core/fuel.Mirror.scala
      variant 1 Citations
        description  a paragraph or heading does not name the code, or lead to the places, the one it translates does
      variant 2 Items
        description  a list has a different number of items from the one it translates
      variant 3 Level
        description  a heading is of a different level from the one it translates
      variant 4 Fence
        description  a fence is not the one it translates
      variant 5 Kind
        description  a block is of a different kind from the one it translates
      variant 6 Extra
        description  the translation has a block the text it translates does not
      variant 7 Lacking
        description  the translation lacks a block the text it translates has
    error 6 Presentation
      description  A presentation is not as it should be
      source src/core/fuel.Presentation.scala
      variant 1 Schema
        description  the presentation schema finds a fault; carries the code of the TEL error
      variant 2 EmptyCode
        description  a slide's code has nothing in its `code`
      variant 3 EmptySlide
        description  a slide is empty
    error 7 SectionFile
      description  A section's file, or a translation of one, is not as it should be
      source src/core/fuel.SectionFile.scala
      variant 1 Schema
        description  the section file's schema finds a fault; carries the code of the TEL error
      variant 2 Untitled
        description  a translation lacks the title of the file it translates
      variant 3 Orphaned
        description  a translation has a title the file it translates no longer has
    error 8 Table
      description  A `tabular` fence is not a table
      source src/core/fuel.Tables.scala
      variant 1 Schema
        description  the table schema finds a fault; carries the code of the TEL error
      variant 2 Alignment
        description  a column is aligned other than `start` or `end`
      variant 3 Wide
        description  a row has more cells than the table has columns
      variant 4 NoColumn
        description  the table has no `column`
      variant 5 NoRow
        description  the table has no `row`
    error 9 Translation
      description  A translation of a document is not of the text it translates as it stands
      source src/core/fuel.Translation.scala
      variant 1 Gained
        description  the text it translates has gained lines which are not translated
      variant 2 Lost
        description  the text it translates has lost lines
      variant 3 Changed
        description  the text it translates has changed
      variant 4 Unpaired
        description  `+` lines translate nothing
      variant 5 Pending
        description  a passage awaits revision, from its `!` lines to its `-` lines
      variant 6 Orphaned
        description  the text a passage translates has gone
      variant 7 Untranslated
        description  a passage is not translated
      variant 8 Absent
        description  a file has no translation into a language it is translated into
        source src/core/fuel.Translations.scala
    error 10 Sample
      description  A fence's `path` cannot be written as a sample file
      source src/core/fuel_core.scala
      variant 1 Escapes
        description  the `path` is not a file within the document's own directory
      variant 2 Unwritable
        description  the sample file cannot be written
    error 11 Fixture
      description  A document's fixture cannot be compiled before its fragments
      source src/core/fuel_core.scala
      variant 1 Unentered
        description  the fixture cannot be entered into the session
      variant 2 Compilation
        description  the fixture does not compile; carries the compiler's code, where it has one
      variant 3 Crash
        description  the compiler fails on the fixture
    error 12 Frame
      description  A frame of an animated fence is not as it should be
      source src/core/fuel_core.scala
      variant 1 NoCode
        description  a frame has no `code`
      variant 2 NoAlternativeCode
        description  a frame of an alternative has no `code`
      variant 3 Unhighlighted
        description  a frame cannot be highlighted
      variant 4 Compilation
        description  a frame does not compile; carries the compiler's code, where it has one
    error 13 Run
      description  A fragment cannot be run, or does not run as its preamble says
      source src/core/fuel_core.scala
      variant 1 Parsed
        description  a fragment which is only parsed is marked to run
      variant 2 Type
        description  a type is marked to run
      variant 3 Animated
        description  an animated fragment is marked to run
      variant 4 Uncompiled
        description  the fragment cannot be compiled to be run
      variant 5 Threw
        description  the fragment throws
      variant 6 NoError
        description  a fragment marked `errors show` runs without error
    error 14 Fragment
      description  A fragment of Scala does not compile as its preamble says
      source src/core/fuel_core.scala
      variant 1 Unshown
        description  a fence with `alternative`s has code after `##`, which is not shown
      variant 2 Unhighlighted
        description  the fragment cannot be highlighted
      variant 3 Compiled
        description  a line marked `// does not compile` compiles
      variant 4 Compilation
        description  the compiler reports on the fragment; carries the compiler's code, where it has one
      variant 5 NoError
        description  a fragment marked `errors show` compiles
