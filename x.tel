tel 1.0 propensive.dev/bolt

# Bolt codes of XEK: `subdivision 1` / `error 8` is ↯/x.1.8. Subdivision 1 is the
# launcher which begins every XEK executable, so its codes are reported by the
# applications built with XEK; the others are reported by the `xek` command and
# the libraries behind it.

project x xek

  subdivision 1 launcher
    description  the native launcher at the start of an XEK executable (src/client)
    error 1 ExecutableNotLocated
      description  the launcher could not locate its own executable
      source src/client/src/main.rs
    error 2 StateDirectoryUnusable
      description  the application's state directory cannot be used
      source src/client/src/main.rs
    error 3 JavaOptionsIgnored
      description  Java options were given, but the daemon is already running with different ones (a warning)
      source src/client/src/main.rs
    error 4 SessionRefused
      description  the daemon ended the session without answering: it speaks another launcher protocol
      source src/client/src/main.rs
    error 5 SessionDropped
      description  the daemon ended the session without reporting the exit status
      source src/client/src/main.rs
    error 6 SocketUntrusted
      description  the daemon's socket is owned by, or open to, another user
      source src/client/src/main.rs
    error 7 SchemaMismatch
      description  the daemon speaks another launcher protocol: its schema is not this launcher's
      source src/client/src/main.rs
    error 8 JavaNotFound
      description  no suitable version of Java was found
      source src/client/src/java.rs
    error 9 NoDownloader
      description  Java could not be downloaded: neither curl nor wget is on the PATH
      source src/client/src/java.rs
    error 10 JavaDownloadFailed
      description  the download of Java failed
      source src/client/src/java.rs
    error 11 JavaUnpackFailed
      description  unpacking the download of Java failed
      source src/client/src/java.rs
    error 12 JavaReleaseMissing
      description  the download of Java contains no `release` file
      source src/client/src/java.rs
    error 13 JavaVersionUnreadable
      description  the version of Java could not be read from its `release` file
      source src/client/src/java.rs
    error 14 JavaNotMoved
      description  the downloaded Java could not be moved into place
      source src/client/src/java.rs
    error 15 DaemonNotStarted
      description  the daemon failed to start
      source src/client/src/state.rs
    error 16 DaemonUnreachable
      description  the daemon could not be reached at its socket
      source src/client/src/state.rs
    error 17 DaemonProcessFailed
      description  the daemon process failed to start, and left its failure marker
      source src/client/src/state.rs

